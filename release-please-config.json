{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "crates/htmx-schema": {
      "release-type": "rust",
      "component": "htmx-schema"
    },
    "crates/htmx-parser": {
      "release-type": "rust",
      "component": "htmx-parser"
    },
    "crates/htmx-vfs": {
      "release-type": "rust",
      "component": "htmx-vfs"
    },
    "crates/htmx-service": {
      "release-type": "rust",
      "component": "htmx-service"
    },
    "crates/htmx-lsp": {
      "release-type": "rust",
      "component": "htmx-analyzer"
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "htmx-analyzer-workspace",
      "components": [
        "htmx-schema",
        "htmx-parser",
        "htmx-vfs",
        "htmx-service",
        "htmx-analyzer"
      ]
    }
  ]
}
